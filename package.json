{
  "name": "agent-gateway-control",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "fix": "biome check --write . && tsc -p tsconfig.json",
    "check": "biome check . && tsc -p tsconfig.json",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun --bun vitest run --project unit",
    "test:integration": "bun --bun vitest run --project integration",
    "test:all": "bun --bun vitest run",
    "test:watch": "bun --bun vitest --project unit",
    "schemas:generate": "bun scripts/generate-json-schemas.ts && biome format --write config/schemas"
  },
  "devDependencies": {
    "@agent-gateway/contracts": "workspace:*",
    "@biomejs/biome": "2.5.14",
    "@testcontainers/postgresql": "12.1.0",
    "@types/bun": "1.4.2",
    "drizzle-kit": "0.31.11",
    "testcontainers": "12.1.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
