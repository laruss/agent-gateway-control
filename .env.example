# Copy to .env for local development (bun loads .env automatically). Development values only.
DATABASE_URL=postgres://gateway:gateway-dev@127.0.0.1:5433/gateway
GATEWAY_ENV=development
HEALTH_PORT=8080
WORKER_ADAPTER=mock
OUTBOX_DELIVERY=dry-run
# With the Mattermost bridge (docs/operations/mattermost.md), after `gateway mattermost bootstrap`:
# OUTBOX_DELIVERY=mattermost
# MATTERMOST_URL=http://127.0.0.1:8065
# SECRETS_DIR=secrets
# GATEWAY_ROUTING_KEY_FILE=secrets/gateway_routing_key
