# $MATTERMOST_HOME/mattermost.env: the stack's settings (no secrets).
MATTERMOST_HOME=/srv/mattermost
# The name clients use: announced over mDNS by the VM (guest/setup-guest.sh), or your LAN's DNS.
MATTERMOST_HOST=mattermost.local
# The Gateway's owner console (ADR-023), same idea: this Caddy proxies it too, and the VM
# announces it over mDNS alongside MATTERMOST_HOST. Reaches nothing until the Gateway's
# gateway.env sets CONSOLE_ENABLED=true and a console password is set.
GATEWAY_HOST=gateway.local
TZ=UTC
