#!/bin/sh
# Runs Docker Compose on this release's stack: `bin/agw up -d`, `bin/agw ps`,
# `bin/agw run --rm gateway-cli gateway doctor`. The settings come from
# $GATEWAY_HOME/gateway.env (default /srv/agent-gateway); the project name is fixed, so every
# release directory manages the same containers and volumes. $GATEWAY_HOME/compose.override.yaml,
# when present, is applied on top (local changes that survive upgrades).
set -eu
release_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
home=${GATEWAY_HOME:-/srv/agent-gateway}
if [ -f "$home/compose.override.yaml" ]; then
	exec docker compose --project-name agent-gateway --project-directory "$release_dir" \
		--env-file "$home/gateway.env" -f "$release_dir/compose.yaml" \
		-f "$home/compose.override.yaml" "$@"
fi
exec docker compose --project-name agent-gateway --project-directory "$release_dir" \
	--env-file "$home/gateway.env" -f "$release_dir/compose.yaml" "$@"
