# Settings of the Gateway stack. Copy to $GATEWAY_HOME/gateway.env; bin/agw passes it to
# Compose. No secrets here: those are files under $GATEWAY_HOME/secrets (secrets.example/).

# Where the Gateway keeps its state (config, secrets, backups): outside every release
# directory, so upgrades and rollbacks keep it. The same path as in bin/agw's environment.
GATEWAY_HOME=/srv/agent-gateway

# Mattermost as the controller reaches it on the shared network, and that network's name.
MATTERMOST_URL=http://mattermost:8065
MATTERMOST_NETWORK=agent-mm

# Which services run besides the database and the controller (Compose profiles):
#   codex        the Codex worker (release image)
#   claude-code  the Claude Code worker (your own build, runtimes/claude-code/)
#   gmail        the Gmail connector
#   tools        the tool runner
#   mock         the mock runtime, for the smoke test only
COMPOSE_PROFILES=codex

# Codex: API key file inside the worker's secrets (unset: the login in the codex-home volume).
# CODEX_API_KEY_FILE=/run/secrets/codex_api_key
# CODEX_WORKER_CONCURRENCY=1

# Claude Code: your build, by digest, and its credential file.
# CLAUDE_CODE_WORKER_IMAGE=registry.example/agent-gateway-worker-claude-code@sha256:...
# ANTHROPIC_API_KEY_FILE=/run/secrets/anthropic_api_key
# CLAUDE_CODE_OAUTH_TOKEN_FILE=/run/secrets/claude_code_oauth_token

# Gmail (polling unless both Pub/Sub names are set).
# GMAIL_MAILBOX_ID=primary
# GMAIL_PUBSUB_TOPIC=projects/<project>/topics/<topic>
# GMAIL_PUBSUB_SUBSCRIPTION=projects/<project>/subscriptions/<subscription>

# Tool runner namespaces; its database role must match (gateway db grant-tool-runner).
# TOOL_RUNNER_NAMESPACES=finance

# The owner's console (ADR-023): a read-only status page at https://gateway.local, through the
# home server's Caddy (deploy/home-server/mattermost/Caddyfile). Enable only after setting a
# password (bin/agw run --rm gateway-cli gateway console password set); the controller refuses
# to start with this on and no password hash set.
CONSOLE_ENABLED=false
