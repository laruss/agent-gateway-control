            "google.gmail.message.received",
            "timer.fired",
            "gateway.control.pause",
            "gateway.control.resume",
            "gateway.control.kill_all"
          ]
        },
        "time": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "datacontenttype": {
          "type": "string",
          "const": "application/json"
        },
        "correlationid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "causationid": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "traceparent": {
          "type": "string",
          "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
        },
        "trustlevel": {
          "type": "string",
          "enum": ["system-trusted", "human-trusted", "internal-untrusted", "external-untrusted"]
        },
        "hop": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "data": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "specversion",
        "id",
        "source",
        "type",
        "time",
        "datacontenttype",
        "correlationid",
        "causationid",
        "trustlevel",
        "hop",
        "data"
      ],
      "additionalProperties": false
    },
