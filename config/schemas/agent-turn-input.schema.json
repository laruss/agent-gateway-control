{
  "$comment": "Structural schema generated from the Zod contracts in @agent-gateway/contracts for editors and tooling. Cross-field rules are not expressed here: validate with the Zod schema (ADR-010).",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "runId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "agent": {
      "type": "object",
      "properties": {
        "agentId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "mattermostUsername": {
          "type": "string",
          "minLength": 1
        },
        "rolePrompt": {
          "type": "string",
          "minLength": 1
        },
        "configVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["agentId", "displayName", "mattermostUsername", "rolePrompt", "configVersion"],
      "additionalProperties": false
    },
    "organization": {
      "type": "object",
      "properties": {
        "organizationId": {
          "type": "string",
          "minLength": 1
        },
        "globalGoal": {
          "type": "string",
          "minLength": 1
        },
        "constitution": {
          "type": "string",
          "minLength": 1
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": ["id", "text"],
            "additionalProperties": false
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "max_agent_hops": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "max_turns_per_cascade": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "max_runs_per_agent_per_hour": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "default_run_timeout_seconds": {
              "type": "integer",
              "minimum": 10,
              "maximum": 86400
