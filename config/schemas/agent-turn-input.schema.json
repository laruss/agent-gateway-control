                  "correlationId",
                  "expectedSenderAgentIds",
                  "expectedSenderUserIds",
                  "requireTargetAgentId",
                  "timeoutAt"
                ],
                "additionalProperties": false
              }
            },
            "required": ["waitId", "outcome", "condition"],
            "additionalProperties": false
