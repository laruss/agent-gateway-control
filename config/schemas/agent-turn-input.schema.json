          "required": [
            "max_agent_hops",
            "max_turns_per_cascade",
            "max_runs_per_agent_per_hour",
            "default_run_timeout_seconds"
          ],
          "additionalProperties": false
        },
        "directory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "agentId": {
                "type": "string",
