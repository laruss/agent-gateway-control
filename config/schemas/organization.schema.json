{
  "$comment": "Structural schema generated from the Zod contracts in @agent-gateway/contracts for editors and tooling. Cross-field rules are not expressed here: validate with the Zod schema (ADR-010).",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "organization": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "global_goal": {
          "type": "string",
          "minLength": 1
        },
        "constitution_file": {
          "type": "string",
          "pattern": "^prompts(\\/[a-z0-9][a-z0-9_-]*)+\\.md$"
        },
        "owner_mattermost_usernames": {
          "minItems": 1,
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          }
        },
        "finance_agent_id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "rules": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": ["id", "text"],
            "additionalProperties": false
          }
        },
        "default_limits": {
          "type": "object",
          "properties": {
            "max_agent_hops": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "max_turns_per_cascade": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "max_runs_per_agent_per_hour": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "default_run_timeout_seconds": {
              "type": "integer",
              "minimum": 10,
              "maximum": 86400
            }
          },
          "required": [
            "max_agent_hops",
            "max_turns_per_cascade",
            "max_runs_per_agent_per_hour",
            "default_run_timeout_seconds"
          ],
          "additionalProperties": false
        },
        "budgets": {
          "type": "object",
          "properties": {
            "per_agent_daily": {
              "type": "object",
              "properties": {
                "cost_usd": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000000
                },
                "tokens": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 10000000000
                }
              },
              "additionalProperties": false
            },
            "global_daily": {
              "type": "object",
              "properties": {
                "cost_usd": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000000
                },
                "tokens": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 10000000000
                }
              },
              "additionalProperties": false
            },
            "unmetered": {
              "default": "hold",
              "type": "string",
              "enum": ["hold", "allow"]
            }
          },
          "additionalProperties": false
        },
        "retention": {
          "default": {},
          "type": "object",
          "properties": {
            "event_content_days": {
              "default": 30,
              "type": "integer",
              "minimum": 8,
              "maximum": 3650
            },
            "run_content_days": {
              "default": 30,
              "type": "integer",
              "minimum": 8,
              "maximum": 3650
            },
            "outbox_sent_days": {
              "default": 8,
              "type": "integer",
              "minimum": 8,
              "maximum": 3650
            },
            "outbox_dead_days": {
              "default": 30,
              "type": "integer",
              "minimum": 8,
              "maximum": 3650
            },
            "policy_input_days": {
              "default": 30,
              "type": "integer",
              "minimum": 8,
              "maximum": 3650
            },
            "thread_summary_days": {
              "default": 90,
              "type": "integer",
              "minimum": 8,
              "maximum": 3650
            },
            "inactive_memory_days": {
              "default": 30,
              "type": "integer",
              "minimum": 8,
              "maximum": 3650
            },
            "usage_days": {
              "default": 400,
              "type": "integer",
              "minimum": 8,
              "maximum": 3650
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "display_name",
        "global_goal",
        "constitution_file",
        "owner_mattermost_usernames",
        "finance_agent_id",
        "rules",
        "default_limits"
      ],
      "additionalProperties": false
    },
    "mattermost": {
      "type": "object",
      "properties": {
        "team": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "channels": {
          "minItems": 1,
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          }
        },
        "approvals_channel": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "alerts_channel": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "listener": {
          "type": "object",
          "properties": {
            "username": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
            },
            "token_secret_file": {
              "type": "string",
              "pattern": "^\\/run\\/secrets\\/[a-z0-9_]+$"
            }
          },
          "required": ["username", "token_secret_file"],
          "additionalProperties": false
        }
      },
      "required": ["team", "channels", "approvals_channel", "alerts_channel", "listener"],
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "organization", "mattermost"],
  "additionalProperties": false
}
