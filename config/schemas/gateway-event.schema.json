          "enum": [
            "mattermost.post.created",
            "mattermost.post.edited",
            "mattermost.post.deleted",
            "mattermost.agent.mentioned"
          ]
        },
        "trustlevel": {
          "enum": ["human-trusted", "internal-untrusted"]
        },
        "data": {
          "type": "object",
          "properties": {
            "post_id": {
              "type": "string",
              "pattern": "^[a-z0-9]{26}$"
            },
            "root_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z0-9]{26}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "channel_id": {
              "type": "string",
              "pattern": "^[a-z0-9]{26}$"
            },
            "user_id": {
              "type": "string",
              "pattern": "^[a-z0-9]{26}$"
            },
            "sender_agent_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 32,
                  "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "target_agent_ids": {
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 2,
                "maxLength": 32,
                "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
              }
            },
            "message": {
