              "pattern": "^[a-z0-9]{26}$"
            },
            "sender_agent_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 32,
                  "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "target_agent_ids": {
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 2,
                "maxLength": 32,
                "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
              }
            },
            "message": {
              "type": "string",
              "maxLength": 16383
            }
          },
          "required": [
            "post_id",
            "root_id",
            "channel_id",
            "user_id",
            "sender_agent_id",
            "target_agent_ids",
            "message"
          ],
          "additionalProperties": false
