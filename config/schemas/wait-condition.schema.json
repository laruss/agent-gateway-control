{
  "$comment": "Structural schema generated from the Zod contracts in @agent-gateway/contracts for editors and tooling. Cross-field rules are not expressed here: validate with the Zod schema (ADR-010).",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "eventType": {
      "type": "string",
      "enum": [
        "mattermost.thread.reply",
        "mattermost.agent.mentioned",
        "approval.granted",
        "approval.denied",
        "google.gmail.message.received",
        "timer.fired"
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "expectedSenderAgentIds": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 32,
        "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
      }
    },
    "expectedSenderUserIds": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]{26}$"
      }
    },
    "requireTargetAgentId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "timeoutAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "eventType",
    "correlationId",
    "expectedSenderAgentIds",
    "expectedSenderUserIds",
    "requireTargetAgentId",
    "timeoutAt"
  ],
  "additionalProperties": false
}
